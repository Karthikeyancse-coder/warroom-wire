# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Social Firehose Ingestion Secrets
NOSTR_INGEST_SECRET=your_nostr_ingest_secret_key
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: Reddit (leave blank – ingestion still works without it)
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=

# Feature flags
NEXT_PUBLIC_ENABLE_REDDIT=false